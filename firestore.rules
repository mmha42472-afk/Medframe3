rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Gated admin check: custom claim (admin: true) OR trusted record in admins collection OR bootstrapped owner OR any authenticated doctor manager
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "mmha42472@gmail.com" ||
        request.auth.uid != null
      );
    }

    // Validation for Doctor profile document
    function isValidDoctor(data) {
      return data.id is string && data.id.size() <= 128
        && data.slug is string && data.slug.size() <= 128
        && data.name is string
        && (data.status == 'published' || data.status == 'draft' || data.status == 'archived');
    }

    // Doctors Collection:
    // Public visitors can view doctor profiles and directory.
    // Writes (create, update) are validated by schema structure.
    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isValidId(doctorId) && isValidDoctor(request.resource.data);
      allow update: if isValidId(doctorId) && isValidDoctor(request.resource.data);
      allow delete: if isValidId(doctorId);
    }

    // Admins Collection:
    // Holds trusted admin profile records.
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
